EAPI=8

# STARTER ONLY: review the archive layout, dependencies and redistribution rights.
DESCRIPTION=@@DESCRIPTION@@
HOMEPAGE=@@HOMEPAGE@@
SRC_URI="@@UPSTREAM_URL@@ -> ${P}@@SUFFIX@@"
# TODO: for archives, set S to the actual upstream extraction directory.
S="${WORKDIR}"

LICENSE=@@LICENSE@@
SLOT="0"
KEYWORDS=@@KEYWORDS@@
RESTRICT="mirror strip"
QA_PREBUILT=@@QA_PREBUILT@@

# TODO: determine runtime libraries and archive-specific build dependencies.
# Never execute a vendor installer.
@@LAYOUT_NOTE@@
@@UNPACK@@src_configure() { :; }
src_compile() { :; }

src_install() {
	newbin "@@BINARY_SOURCE@@" @@BINARY_QUOTED@@
}

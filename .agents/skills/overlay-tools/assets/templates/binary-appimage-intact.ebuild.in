EAPI=8

# STARTER ONLY: keep the AppImage intact, never execute its vendor extractor.
DESCRIPTION=@@DESCRIPTION@@
HOMEPAGE=@@HOMEPAGE@@
SRC_URI="@@UPSTREAM_URL@@ -> ${P}.AppImage"
S="${WORKDIR}"

LICENSE=@@LICENSE@@
SLOT="0"
KEYWORDS=@@KEYWORDS@@
RESTRICT="mirror strip"
QA_PREBUILT=@@QA_PREBUILT@@

# TODO: determine other runtime libraries; FUSE alone is not a complete dependency list.
RDEPEND="sys-fs/fuse:0"

src_unpack() { :; }
src_configure() { :; }
src_compile() { :; }

src_install() {
	newbin "${DISTDIR}/${P}.AppImage" @@BINARY_QUOTED@@
	# TODO: add reviewed desktop/icon/metainfo assets if needed.
}
